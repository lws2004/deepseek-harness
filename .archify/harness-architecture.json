  "cards": [
    {
      "dot": "cyan",
      "title": "启动与组合",
      "items": [
        "dsh CLI 以命名 profile 启动全部受支持的 Node 应用",
        "profile = 有序 bundle 层 + patch:dsh-base / web-app / headless / sdk-app / acp-app",
        "patch 按 id 替换整行配置,自定义 profile 支持热重载"
      ]
    },
    {
      "dot": "violet",
      "title": "一次 turn",
      "items": [
        "inbox 认领输入,agent/pre-step 瀑布决定模型可见内容",
        "agent/request → llm/stream 流式返回,提交为 assistant/message",
        "tool/call 经 pre-execute → execute → post-execute 管道"
      ]
    },
    {
      "dot": "emerald",
      "title": "会话真相与扩展点",
      "items": [
        "append-only SessionEvent 日志:模型可见 ⟺ 已记录",
        "deriveMessages() 从日志投影模型历史,fork / resume / 回放同源",
        "session/* · agent/* · tools/* 三类事件域即扩展点"
      ]
    }
  ]
